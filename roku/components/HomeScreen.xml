<?xml version="1.0" encoding="utf-8" ?>
<!-- The home screen. On top, the hero card: the last watched video, with its logo,
     episode, synopsis, progress, Resume and Go to show. After 15 s it plays in the
     card behind the text, with sound. Down goes to the rows (Recently Watched, TV
     Shows, Movies, Clips); Up on the first row comes back. In the rows, the
     active row sits under the header and its selected card is expanded. Give this
     node focus. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <!-- From LibraryTask: one child per row, one grandchild per card. -->
    <field id="content" type="node" onChange="onContent" />
    <!-- The hero video from /api/library ({} = none) and its show ({} = none).
         Set heroShow, then hero, then content. -->
    <field id="hero" type="assocarray" onChange="onHero" />
    <field id="heroShow" type="assocarray" />
    <!-- The small grey line over the hero: "Continue Watching", "Up Next", "New". -->
    <field id="heroKicker" type="string" />
    <field id="status" type="string" onChange="onStatus" />
    <!-- Out: the selected card's ContentNode, on every move and after a refresh;
         invalid while the hero has focus. -->
    <field id="focusedItem" type="node" alwaysNotify="true" />
    <!-- Out: OK on a card. -->
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <!-- Out: Play on a card. -->
    <field id="playItem" type="node" alwaysNotify="true" />
    <!-- Out: a hero button or Play on the hero. { action: "play", start } or { action: "show" } -->
    <field id="heroAction" type="assocarray" alwaysNotify="true" />
    <!-- Out: true while the hero has focus. -->
    <field id="heroFocused" type="boolean" />
    <!-- Out: where the expanded picture is on screen: [x, y, width, height]. -->
    <field id="cardRect" type="array" />
    <!-- Stop the hero video now (MainScene calls it before playing anything). -->
    <function name="stopHero" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/util.brs" />
  <children>
    <!-- The hero card: 1728x720 under the header, rounded. The video is 16:9 and
         taller than the card; the black bar under the card and the header hide what
         sticks out (the page is black), so it looks cropped to the card. -->
    <Group id="hero" visible="false">
      <Rectangle translation="[96,104]" width="1728" height="720" color="0x1A1A1AFF" />
      <Poster id="heroArt" translation="[96,104]" width="1728" height="720" loadWidth="1728" loadHeight="720" loadDisplayMode="scaleToZoom" />
      <Video id="heroVideo" enableUI="false" translation="[96,-22]" width="1728" height="972" visible="false" />
      <Rectangle translation="[96,824]" width="1728" height="130" color="0x000000FF" />
      <Poster uri="pkg:/images/fade_left.png" translation="[96,104]" width="1150" height="720" loadDisplayMode="scaleToFill" />
      <Poster uri="pkg:/images/fade_bottom.png" translation="[96,424]" width="1728" height="400" loadDisplayMode="scaleToFill" />
      <Poster uri="pkg:/images/round_mask_lg.9.png" translation="[96,104]" width="1728" height="720" />
      <!-- A thin red border on the same rounded edge. -->
      <Poster uri="pkg:/images/ring_lg.9.png" translation="[96,104]" width="1728" height="720" blendColor="0xE50914FF" />
      <Label id="heroKicker" translation="[160,136]" font="font:SmallBoldSystemFont" color="0xBDBDBDFF" />
      <Logo id="heroLogo" translation="[160,180]" maxWidth="700" maxHeight="190" />
      <Label id="heroMeta" translation="[160,0]" width="1000" font="font:SmallSystemFont" color="0xBDBDBDFF" />
      <Label id="heroEpisode" translation="[160,0]" width="1000" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="heroDesc" translation="[160,0]" width="900" wrap="true" maxLines="2" lineSpacing="6" font="font:SmallSystemFont" color="0xD4D4D4FF" />
      <Group id="heroProgress" translation="[160,0]">
        <Rectangle width="420" height="6" color="0xFFFFFF40" />
        <Rectangle id="heroBar" width="0" height="6" color="0xE50914FF" />
        <Label id="heroLeft" translation="[444,-18]" font="font:SmallSystemFont" color="0xBDBDBDFF" />
      </Group>
      <ButtonRow id="heroButtons" translation="[160,0]" minWidth="260" />
    </Group>
    <Group id="stack" translation="[96,120]" />
    <!-- Holds focus while the rows are active; the keys reach this component from
         it. (Focusing this component itself does not take focus away from the hero
         buttons, which are inside it.) -->
    <Group id="rowsFocus" focusable="true" />
    <Rectangle id="headerBar" width="1920" height="104" color="0x000000FF" />
    <Label id="statusLabel" translation="[96,42]" width="1100" font="font:SmallestSystemFont" color="0x8C8C8CFF" />
    <!-- The app name, styled as a logo, top right. -->
    <Label id="brand" text="KUBENEX" translation="[1224,30]" width="600" horizAlign="right" font="font:MediumBoldSystemFont" color="0xE50914FF" />
    <Animation id="scrollAnim" duration="0.25" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="stack.translation" />
    </Animation>
    <!-- The hero slides up and fades as the rows rise (and back down on return),
         in step with scrollAnim. -->
    <Animation id="heroAnim" duration="0.4" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="heroMove" key="[0.0, 1.0]" fieldToInterp="hero.translation" />
      <FloatFieldInterpolator id="heroFade" key="[0.0, 1.0]" fieldToInterp="hero.opacity" />
    </Animation>
    <Timer id="heroTimer" repeat="false" duration="15" />
  </children>
</component>
