<?xml version="1.0" encoding="utf-8" ?>
<!-- A small menu over everything else: a title and a list of choices.
     Used for Resume / Start over and for the * menus. -->
<component name="ChoiceDialog" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTitle" />
    <field id="options" type="array" onChange="onOptions" />
    <!-- Out: index of the chosen option. -->
    <field id="selected" type="integer" alwaysNotify="true" />
    <!-- Out: Back was pressed. -->
    <field id="cancelled" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ChoiceDialog.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000B0" />
    <Rectangle id="panel" translation="[410,250]" width="1100" height="580" color="0x1C1C1CFF" />
    <Label id="titleLabel" translation="[450,286]" width="1020" font="font:MediumBoldSystemFont" wrap="true" maxLines="2" />
    <LabelList id="list" translation="[450,410]" itemSize="[1020,64]" numRows="6" />
  </children>
</component>
