<?xml version="1.0" encoding="utf-8" ?>
<!-- One card in a home screen row (480x270 picture): thumbnail, title, a grey
     second line, a progress bar while part-watched, and a badge once watched. -->
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
  <children>
    <!-- Shows through when a video has no thumbnail. -->
    <Rectangle width="480" height="270" color="0x262626FF" />
    <Poster id="poster" width="480" height="270" loadDisplayMode="scaleToFill" />
    <Rectangle id="track" translation="[0,263]" width="480" height="7" color="0x00000099" visible="false" />
    <Rectangle id="bar" translation="[0,263]" width="0" height="7" color="0x60A5FAFF" visible="false" />
    <Group id="badge" translation="[366,12]" visible="false">
      <Rectangle width="102" height="36" color="0x16A34AE6" />
      <Label text="Watched" width="102" height="36" horizAlign="center" vertAlign="center" font="font:SmallestBoldSystemFont" />
    </Group>
    <Label id="title" translation="[0,282]" width="480" font="font:SmallBoldSystemFont" />
    <Label id="sub" translation="[0,322]" width="480" font="font:SmallestSystemFont" color="0xA3A3A3FF" />
  </children>
</component>
