<?xml version="1.0" encoding="utf-8" ?>
<!-- One TV show: the logo, year and seasons on the left; the selected season's
     episodes, with their synopses, on the right. -->
<component name="ShowScreen" extends="Group">
  <interface>
    <!-- One entry of library.shows. Setting it opens the screen; setting the same
         show again (after a library refresh) keeps the season and episode in focus. -->
    <field id="show" type="assocarray" onChange="onShow" />
    <!-- Out: id of the episode picked with OK. -->
    <field id="selectedVideoId" type="string" alwaysNotify="true" />
    <!-- Out: * was pressed. { kind: "episode", id } or { kind: "season", ids, label }. -->
    <field id="menuRequest" type="assocarray" alwaysNotify="true" />
    <!-- Out: Back was pressed. -->
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ShowScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/util.brs" />
  <children>
    <Rectangle color="0x000000FF" width="1920" height="1080" />
    <!-- The show's background, dim, behind everything; darker on the left. -->
    <Poster id="backdrop" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" opacity="0.35" />
    <Poster uri="pkg:/images/fade_left.png" width="1200" height="1080" loadDisplayMode="scaleToFill" />

    <Logo id="logo" translation="[96,70]" maxWidth="520" maxHeight="180" />
    <Label id="meta" translation="[96,272]" width="520" font="font:SmallSystemFont" color="0xBDBDBDFF" />
    <!-- The season you are in stays marked (grey) while focus is on the episodes. -->
    <LabelList id="seasons" translation="[96,340]" itemSize="[520,68]" numRows="10"
      focusBitmapUri="pkg:/images/btn.9.png" focusFootprintBitmapUri="pkg:/images/btn.9.png"
      focusFootprintBlendColor="0x333333FF" color="0xFFFFFFFF" focusedColor="0x111111FF" />
    <MarkupList id="episodes"
      translation="[680,60]"
      itemComponentName="EpisodeItem"
      itemSize="[1144,300]"
      itemSpacing="[0,16]"
      numRows="3"
      vertFocusAnimationStyle="floatingFocus"
      drawFocusFeedbackOnTop="false"
      focusBitmapUri="pkg:/images/btn.9.png"
      focusBitmapBlendColor="0xFFFFFF26"
      focusFootprintBitmapUri="pkg:/images/btn.9.png"
      focusFootprintBlendColor="0x00000000" />
  </children>
</component>
