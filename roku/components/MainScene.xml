<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/components/util.brs" />
  <children>
    <Rectangle color="0x0A0A0AFF" width="1920" height="1080" />

    <!-- Rows of cards. The selected card grows; after a while it plays a preview. -->
    <HomeScreen id="home" />

    <!-- Details screen, back layer: the big picture. The preview plays on top of
         it, and the details text (DetailsScreen) on top of that. -->
    <Group id="detailsBack" visible="false">
      <Rectangle color="0x0A0A0AFF" width="1920" height="1080" />
      <Poster id="detailsArt" translation="[640,0]" width="1280" height="720" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToFill" />
    </Group>

    <!-- Preview: the focused video, with sound, inside its card (home) or behind
         the details text. It never reports progress. -->
    <Group id="preview" visible="false">
      <Video id="previewVideo" enableUI="false" width="960" height="540" />
      <Group id="previewProgress">
        <Rectangle id="previewTrack" height="7" color="0xFFFFFF40" />
        <Rectangle id="previewBar" width="0" height="7" color="0xE50914FF" />
      </Group>
    </Group>
    <Timer id="previewTimer" repeat="false" duration="10" />

    <DetailsScreen id="details" visible="false" />
    <ShowScreen id="showScreen" visible="false" />
    <Video id="video" width="1920" height="1080" visible="false" />

    <!-- Player overlays. They take focus while visible, so OK presses them. -->
    <Group id="skipIntro" translation="[1440,880]" visible="false">
      <ButtonRow id="skipButton" minWidth="320" />
    </Group>
    <Group id="upNext" translation="[960,700]" visible="false">
      <Poster uri="pkg:/images/panel.9.png" width="900" height="300" blendColor="0x000000D9" />
      <Label id="upNextTitle" translation="[40,28]" width="820" wrap="true" maxLines="2" font="font:MediumBoldSystemFont" />
      <Label id="upNextCount" translation="[40,124]" width="820" wrap="true" maxLines="2" font="font:SmallSystemFont" color="0xBDBDBDFF" />
      <ButtonRow id="upNextButton" translation="[40,196]" minWidth="280" />
    </Group>
    <!-- While paused: Resume, Previous, Play from beginning, Next, Subtitles.
         Sits above the Roku's own progress bar. -->
    <Group id="pauseBar" translation="[96,740]" visible="false">
      <ButtonRow id="pauseButtons" minWidth="220" />
    </Group>
    <Timer id="countdown" repeat="true" duration="1" />

    <ChoiceDialog id="dialog" visible="false" />
  </children>
</component>
