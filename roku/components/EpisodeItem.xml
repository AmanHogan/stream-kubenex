<?xml version="1.0" encoding="utf-8" ?>
<!-- One episode on the show screen (1144x300): thumbnail with its progress bar on
     the left; number and name, length or time left, and the synopsis on the right. -->
<component name="EpisodeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/EpisodeItem.brs" />
  <children>
    <Rectangle translation="[16,16]" width="320" height="180" color="0x1A1A1AFF" />
    <Poster id="thumb" translation="[16,16]" width="320" height="180" loadWidth="320" loadHeight="180" loadDisplayMode="scaleToZoom" />
    <Rectangle id="track" translation="[16,191]" width="320" height="5" color="0xFFFFFF40" visible="false" />
    <Rectangle id="bar" translation="[16,191]" width="0" height="5" color="0xE50914FF" visible="false" />
    <Label id="title" translation="[364,20]" width="760" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
    <Label id="meta" translation="[364,68]" width="760" font="font:SmallSystemFont" color="0x8C8C8CFF" />
    <!-- 6 lines of the smaller font: about 350 characters, enough for nearly every
         TVmaze synopsis (median 157, longest so far 429). -->
    <Label id="desc" translation="[364,106]" width="760" wrap="true" maxLines="6" lineSpacing="2" font="font:SmallestSystemFont" color="0xBDBDBDFF" />
  </children>
</component>
